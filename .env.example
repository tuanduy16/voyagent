# Claude API key (or run `ant auth login` instead).
# Not needed if you run with --subscription (uses your Claude Pro/Max login via Claude Code).
ANTHROPIC_API_KEY=

# Make --subscription the default:
# VOYAGENT_BACKEND=subscription

# Optional: live Google Flights / Google Hotels prices via SerpApi (https://serpapi.com).
# Without it, the flight/hotel agents use Claude's web search and label prices as estimates.
SERPAPI_API_KEY=

# Wikipedia/OpenStreetMap ask for a contact URL or email in the User-Agent; put yours here.
# VOYAGENT_USER_AGENT=Voyagent/0.1 (https://your-site-or-repo) python-httpx

# Optional tuning
# VOYAGENT_MODEL=claude-opus-5-5
# VOYAGENT_SPECIALIST_MODEL=claude-opus-5-5
# VOYAGENT_ORCHESTRATOR_EFFORT=high
# VOYAGENT_SPECIALIST_EFFORT=medium
# VOYAGENT_FALLBACKS=1
